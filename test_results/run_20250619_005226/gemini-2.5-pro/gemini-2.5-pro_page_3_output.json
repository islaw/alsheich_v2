        "content": [
          {
            "line_number": 3,
            "speaker": "כב' השופטת ר' פרידמן-פלדמן",
            "speaker_role": "אב\"ד",
            "text": "בוקר טוב לכולם. היום 8 במאי 2024"
          },
          {
            "line_number": 4,
            "speaker": "כב' השופטת ר' פרידמן-פלדמן",
            "speaker_role": "אב\"ד",
            "text": "תיק פלילי 67104-01-20. חודש טוב ואנחנו מתחילים עם העדה."
          },
          {
            "line_number": 5,
            "speaker": "כב' השופטת ר' פרידמן-פלדמן",
            "speaker_role": "אב\"ד",
            "text": "אנחנו עם הגברת שלומית ברנע פרגו, עורכת דין."
          },
          {
            "line_number": 6,
            "speaker": "כב' השופטת ר' פרידמן-פלדמן",
            "speaker_role": "אב\"ד",
            "text": "קודם כל שלום לך."
          },
          {
            "line_number": 7,
            "speaker": "ת.",
            "speaker_role": "עדה",
            "text": "שלום רב."
          },
          {
            "line_number": 8,
            "speaker": "כב' השופטת ר' פרידמן-פלדמן",
            "speaker_role": "אב\"ד",
            "text": "כמו כל עד ועדה את חייבת להעיד את האמת, כל האמת,"
          },
          {
            "line_number": 9,
            "speaker": "כב' השופטת ר' פרידמן-פלדמן",
            "speaker_role": "אב\"ד",
            "text": "רק את האמת אחרת צפויה לעונשים הקבועים בחוק."
          },
          {
            "line_number": 10,
            "speaker": "כב' השופטת ר' פרידמן-פלדמן",
            "speaker_role": "אב\"ד",
            "text": "אם את צריכה הפסקה תגידי לנו, את יכולה לשתות אם את רוצה."
          },
          {
            "line_number": 11,
            "speaker": "כב' השופטת ר' פרידמן-פלדמן",
            "speaker_role": "אב\"ד",
            "text": "אנחנו מתחילים, חקירה ראשית בבקשה."
          },
          {
            "line_number": 12,
            "speaker": "עו\"ד נועה פירר",
            "speaker_role": "ב\"כ המאשימה",
            "text": "בוקר טוב. במסגרת האישום שלנו הודעת העדה הוגשה לבית המשפט"
          },
          {
            "line_number": 13,
            "speaker": "כב' השופטת ר' פרידמן-פלדמן",
            "speaker_role": "אב\"ד",
            "text": "היא הוגשה ונסרקה."
          },
          {
            "line_number": 14,
            "speaker": "עו\"ד נועה פירר",
            "speaker_role": "ב\"כ המאשימה",
            "text": "כן, רצינו רק להוסיף מה שלא נכתב והוסכם עם חברינו שזה בהתאם להסתייגויות"
          },
          {
            "line_number": 15,
            "speaker": "עו\"ד נועה פירר",
            "speaker_role": "ב\"כ המאשימה",
            "text": "המקובלות בדבר עדות שמועה וסברה."
          },
          {
            "line_number": 16,
            "speaker": "כב' השופטת ר' פרידמן-פלדמן",
            "speaker_role": "אב\"ד",
            "text": "מאה אחוז. תודה."
          },
          {
            "line_number": 17,
            "speaker": "כב' השופט ע' שחם",
            "speaker_role": "שופט",
            "text": "ברור, ברור."
          }
        ]
      },
      {
        "type": "testimony",
        "title": "ע\"ת 118 עו\"ד שלומית ברנע-פרגו לאחר שהוזהרה כדין משיבה לשאלות עו\"ד טפת מויאל-רוטשילד בחקירה ראשית",
        "content": [
          {
            "line_number": 21,
            "speaker": "ש.",
            "speaker_role": "ב\"כ המאשימה",
            "text": "בוקר טוב שלומית."
          },
          {
            "line_number": 22,
            "speaker": "ת.",
            "speaker_role": "עדה",
            "text": "בוקר אור."
          },
          {
            "line_number": 23,
            "speaker": "ש.",
            "speaker_role": "ב\"כ המאשימה",
            "text": "אם את יכולה בבקשה להציג את תפקידך בפני בית המשפט?"
          }
        ]
      }
